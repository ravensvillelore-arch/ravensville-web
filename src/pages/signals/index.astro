---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const signals = await getCollection('signals');
const sorted = signals.sort((a, b) => b.data.week - a.data.week);
const latest = sorted[0];
const previous = sorted.slice(1, 4);
---
<Base title="Signals" description="Weekly pattern analysis from the Ravensville simulation — what the town is saying beneath the surface.">
  <style>
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 1.5rem;
      display: block;
    }
    .hero-title {
      font-family: var(--serif);
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 700;
      line-height: 1.15;
      color: var(--paper);
      margin-bottom: 1rem;
      letter-spacing: -0.01em;
    }
    .hero-summary {
      font-size: 1.25rem;
      color: var(--cream);
      line-height: 1.8;
      font-style: italic;
      border-left: 2px solid var(--amber);
      padding-left: 1.5rem;
      margin-bottom: 2rem;
    }
    .read-more {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--amber);
      border-bottom: 1px solid var(--amber);
      padding-bottom: 0.1rem;
      display: inline-block;
      margin-bottom: 3rem;
    }
    .divider {
      border: none;
      border-top: 1px solid var(--ash);
      margin: 3.5rem 0;
    }
    .section-header {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--mist);
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .section-header a {
      color: var(--ash);
      font-size: 0.6rem;
    }
    .section-header a:hover { color: var(--amber); }
    .archive-list { list-style: none; }
    .archive-item {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--smoke);
    }
    .archive-item:last-child { border-bottom: none; }
    .archive-title {
      font-family: var(--serif);
      font-size: 1.1rem;
      color: var(--cream);
    }
    .archive-title:hover { color: var(--amber); }
    .archive-week {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--mist);
      letter-spacing: 0.1em;
      white-space: nowrap;
      margin-left: 1rem;
    }

    /* Coming soon */
    .coming-soon {
      border: 1px solid var(--ash);
      padding: 3rem 2rem;
      text-align: center;
      background: rgba(26,24,20,0.4);
      margin-top: 2rem;
    }
    .coming-soon-label {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 1rem;
    }
    .coming-soon-note {
      font-size: 0.95rem;
      color: var(--mist);
      font-style: italic;
    }
    .what-is {
      font-size: 1rem;
      color: var(--mist);
      line-height: 1.9;
      margin-bottom: 2rem;
    }
  </style>

  <span class="eyebrow">Weekly Patterns</span>

  {latest ? (
    <>
      <span class="eyebrow" style="margin-bottom:0.5rem">
        Latest signal &mdash; {latest.data.season}, Week {latest.data.week}
      </span>
      <h1 class="hero-title">{latest.data.title}</h1>
      {latest.data.summary && (
        <p class="hero-summary">{latest.data.summary}</p>
      )}
      <a href={`/signals/${latest.id}`} class="read-more">Read full signal &rarr;</a>

      {previous.length > 0 && (
        <>
          <hr class="divider" />
          <div class="section-header">
            <span>Previous signals</span>
            <a href="/signals/archive">View all &rarr;</a>
          </div>
          <ul class="archive-list">
            {previous.map(signal => (
              <li class="archive-item">
                <a href={`/signals/${signal.id}`} class="archive-title">{signal.data.title}</a>
                <span class="archive-week">{signal.data.season}, Week {signal.data.week}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  ) : (
    <>
      <h1 class="hero-title">Signals</h1>
      <p class="what-is">
        Each week the simulation is read not for what happened, but for what it means. The best exchanges. The developing threads. The patterns emerging beneath the surface.
      </p>
      <div class="coming-soon">
        <p class="coming-soon-label">First signal incoming</p>
        <p class="coming-soon-note">Ravensville is accumulating history. Check back after the first sim week completes.</p>
      </div>
    </>
  )}
</Base>
