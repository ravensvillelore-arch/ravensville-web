---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const signals = await getCollection('signals');
  return signals.map(signal => ({
    params: { slug: signal.id },
    props: { signal },
  }));
}

const { signal } = Astro.props;
const d = signal.data;
const dayRange = `Days ${d.days[0]}–${d.days[d.days.length - 1]}`;

const LOCATION_LABELS: Record<string, string> = {
  'town-square':     'Town Square',
  'brewsome':        'Brewsome',
  'twisted-olive':   'The Twisted Olive',
  'the-park':        'The Park',
  'vance-therapy':   'Vance Therapy',
  'private-threads': 'Private',
};
const locationLabel = LOCATION_LABELS[d.location] ?? d.location;
---
<Base title={`Signals: ${d.title}`} description={d.summary}>
  <style>
    .back {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
      display: inline-block;
      margin-bottom: 3rem;
    }
    .back:hover { color: var(--amber); }

    .eyebrow {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 0.75rem;
      display: block;
    }
    h1 {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--paper);
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }
    .summary {
      font-size: 1.1rem;
      color: var(--mist);
      font-style: italic;
      margin-bottom: 2.5rem;
      line-height: 1.7;
    }

    /* Setup */
    .setup {
      font-size: 1.05rem;
      color: var(--cream);
      line-height: 1.9;
      border-left: 2px solid var(--amber);
      padding-left: 1.5rem;
      margin-bottom: 3rem;
    }

    /* Scene header */
    .scene-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--ash);
    }
    .scene-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
    }
    .scene-location {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--amber);
    }
    .scene-dot {
      color: var(--ash);
      font-size: 0.5rem;
    }

    /* Transcript */
    .transcript { list-style: none; }
    .exchange {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 1.5rem;
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--smoke);
    }
    .exchange:last-child { border-bottom: none; }
    @media (max-width: 600px) {
      .exchange {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }
    }
    .exchange-who {
      padding-top: 0.15rem;
    }
    .exchange-character {
      font-family: var(--serif);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--cream);
      display: block;
      margin-bottom: 0.2rem;
    }
    .exchange-time {
      font-family: var(--mono);
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ash);
      line-height: 1.5;
    }
    .exchange-line {
      font-size: 1rem;
      color: var(--pale);
      line-height: 1.85;
    }

    /* Closing */
    .closing {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--ash);
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--mist);
      letter-spacing: 0.05em;
      font-style: italic;
    }
  </style>

  <a href="/signals" class="back">&larr; Signals</a>

  <span class="eyebrow">
    Week {d.week} &mdash; {d.season}, {dayRange} &mdash; {d.pubDate}
  </span>
  <h1>{d.title}</h1>
  <p class="summary">{d.summary}</p>

  <p class="setup">{d.setup}</p>

  <div class="scene-header">
    <span class="scene-label">The record</span>
    <span class="scene-dot">&#9679;</span>
    <span class="scene-location">{locationLabel}</span>
    <span class="scene-dot">&#9679;</span>
    <span class="scene-label">Day {d.sim_day} &mdash; {d.exchanges.length} exchanges</span>
  </div>

  <ul class="transcript">
    {d.exchanges.map(ex => (
      <li class="exchange">
        <div class="exchange-who">
          <span class="exchange-character">{ex.character}</span>
          <span class="exchange-time">{ex.time_label}</span>
        </div>
        <p class="exchange-line">{ex.line}</p>
      </li>
    ))}
  </ul>

  {d.closing && (
    <p class="closing">{d.closing}</p>
  )}
</Base>
