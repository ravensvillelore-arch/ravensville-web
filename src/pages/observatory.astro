---
import Base from '../layouts/Base.astro';
import observatoryData from '../data/observatory-data.json';
import weeklyData from '../data/observatory-weekly.json';

const simStart = observatoryData.simStart;
const currentDay = observatoryData.currentDay;
const currentSeason = observatoryData.currentSeason;

const dayData = observatoryData.dayData;
const totalScenes = observatoryData.totalScenes;
const totalSolos = observatoryData.totalSolos;
const totalTicks = observatoryData.totalTicks;
const overallRatio = observatoryData.overallRatio;

const topPairs = observatoryData.topPairs;
const locationData = observatoryData.locationData;
const maxLocationScenes = observatoryData.maxLocationScenes;
const maxDayScenes = observatoryData.maxDayScenes;

const weeks = weeklyData.weeks.slice().sort((a, b) => b.week - a.week);
const latestWeek = weeks[0];
---
<Base title="Observatory" description="The data layer underneath Ravensville — scene analytics, character patterns, simulation health.">
  <style>
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--purple-hi);
      margin-bottom: 1rem;
      display: block;
    }
    h1 {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--paper);
      margin-bottom: 1rem;
      line-height: 1.15;
    }
    .lead {
      font-size: 1rem;
      color: var(--mist);
      line-height: 1.8;
      margin-bottom: 3rem;
      font-style: italic;
    }

    /* Section nav */
    .section-nav {
      position: sticky;
      top: 65px;
      background: rgba(10,9,8,0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--smoke);
      padding: 0.75rem 0;
      margin: 0 -2rem 3rem;
      padding-left: 2rem;
      padding-right: 2rem;
      z-index: 50;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .section-nav a {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--mist);
      padding-bottom: 0.2rem;
    }
    .section-nav a:hover { color: var(--purple-hi); border-bottom: 1px solid var(--purple-hi); }

    /* Section headers */
    .section {
      margin-bottom: 5rem;
      scroll-margin-top: 120px;
    }
    h2 {
      font-family: var(--serif);
      font-size: 1.6rem;
      font-weight: 400;
      font-style: italic;
      color: var(--paper);
      margin-bottom: 0.5rem;
    }
    .section-rule {
      border: none;
      border-top: 1px solid var(--purple-lo);
      margin-bottom: 2rem;
    }

    /* Overview stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1px;
      background: var(--ash);
      margin-bottom: 2rem;
    }
    .stat {
      background: var(--fog);
      padding: 1.5rem;
      text-align: center;
    }
    .stat-value {
      font-family: var(--mono);
      font-size: 2rem;
      color: var(--purple-hi);
      display: block;
      margin-bottom: 0.25rem;
    }
    .stat-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
    }
    .note {
      font-size: 0.85rem;
      color: var(--mist);
      font-style: italic;
      margin-top: 1rem;
    }

    /* Scene ratio chart */
    .ratio-chart {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .ratio-row {
      display: grid;
      grid-template-columns: 60px 1fr 60px;
      gap: 0.75rem;
      align-items: center;
    }
    .ratio-label {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--mist);
      text-align: right;
    }
    .ratio-bar-track {
      background: var(--smoke);
      height: 28px;
      position: relative;
      overflow: hidden;
    }
    .ratio-bar-scene {
      background: var(--purple-hi);
      height: 100%;
      display: flex;
      align-items: center;
      padding-left: 0.5rem;
      font-family: var(--mono);
      font-size: 0.6rem;
      color: white;
      white-space: nowrap;
      transition: width 0.3s;
    }
    .ratio-bar-solo {
      position: absolute;
      top: 0;
      right: 0;
      height: 100%;
      background: var(--smoke);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 0.5rem;
      font-family: var(--mono);
      font-size: 0.6rem;
      color: var(--mist);
    }
    .ratio-pct {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--purple-hi);
    }
    .target-line {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--mist);
      margin-top: 0.5rem;
      padding-left: 68px;
    }

    /* Pairs table */
    .pairs-table {
      width: 100%;
      border-collapse: collapse;
    }
    .pairs-table th {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--ash);
    }
    .pairs-table td {
      padding: 0.6rem 0.75rem;
      border-bottom: 1px solid var(--smoke);
      font-size: 0.95rem;
      color: var(--pale);
    }
    .pairs-table tr:hover td { background: rgba(45,27,78,0.15); }
    .pair-count {
      font-family: var(--mono);
      font-size: 0.85rem;
      color: var(--purple-hi);
      font-weight: bold;
    }
    .pair-bar {
      display: inline-block;
      height: 8px;
      background: var(--purple-mid);
      vertical-align: middle;
      margin-left: 0.5rem;
      border-radius: 2px;
    }

    /* Location bars */
    .location-bars {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .loc-row {
      display: grid;
      grid-template-columns: 140px 1fr 40px;
      gap: 0.75rem;
      align-items: center;
    }
    .loc-name {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--pale);
      text-align: right;
    }
    .loc-track {
      background: var(--smoke);
      height: 24px;
      position: relative;
    }
    .loc-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--purple-lo), var(--purple-hi));
    }
    .loc-count {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--purple-hi);
    }

    /* Weekly vitals table */
    .vitals-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1rem;
    }
    .vitals-table th {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--ash);
    }
    .vitals-table td {
      padding: 0.65rem 0.75rem;
      border-bottom: 1px solid var(--smoke);
      font-size: 0.9rem;
      color: var(--pale);
      vertical-align: top;
    }
    .vitals-table tr:hover td { background: rgba(45,27,78,0.12); }
    .vitals-number {
      font-family: var(--mono);
      font-size: 1rem;
      color: var(--purple-hi);
    }
    .vitals-pair {
      font-size: 0.85rem;
      color: var(--pale);
    }
    .vitals-pair-count {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--purple-hi);
      margin-left: 0.4rem;
    }

    /* Character pulse */
    .pulse-table {
      width: 100%;
      border-collapse: collapse;
    }
    .pulse-table th {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--ash);
    }
    .pulse-table td {
      padding: 0.55rem 0.75rem;
      border-bottom: 1px solid var(--smoke);
      font-size: 0.9rem;
      color: var(--pale);
    }
    .pulse-table tr:hover td { background: rgba(45,27,78,0.12); }
    .pulse-char {
      font-family: var(--serif);
      font-size: 0.95rem;
      color: var(--cream);
    }
    .pulse-count {
      font-family: var(--mono);
      font-size: 0.85rem;
      color: var(--purple-hi);
    }
    .pulse-solo {
      font-family: var(--mono);
      font-size: 0.85rem;
      color: var(--mist);
    }
    .pulse-week-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 1rem;
    }

    /* Emergent patterns */
    .patterns-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .pattern-item {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      padding: 1rem 0;
      border-bottom: 1px solid var(--smoke);
    }
    .pattern-item:last-child { border-bottom: none; }
    .pattern-bullet {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--purple-hi);
      padding-top: 0.2rem;
    }
    .pattern-text {
      font-size: 0.95rem;
      color: var(--pale);
      line-height: 1.75;
    }
    .patterns-week-eyebrow {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 1.5rem;
      display: block;
    }

    .update-note {
      margin-top: 4rem;
      padding: 1.5rem;
      border: 1px solid var(--smoke);
      background: rgba(26,24,20,0.4);
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--mist);
      letter-spacing: 0.08em;
      line-height: 1.8;
    }
  </style>

  <span class="eyebrow">Simulation Analytics</span>
  <h1>The Observatory</h1>
  <p class="lead">
    The data layer underneath Ravensville. Scene density, character pair dynamics, location activity — the structural health of an autonomous town. Updated as the simulation accumulates history.
  </p>

  <nav class="section-nav">
    <a href="#overview">Overview</a>
    <a href="#scene-ratio">Scene Ratio</a>
    <a href="#pairs">Character Pairs</a>
    <a href="#locations">Locations</a>
    <a href="#weekly-vitals">Weekly Vitals</a>
    <a href="#character-pulse">Character Pulse</a>
    <a href="#emergent">Emergent Patterns</a>
  </nav>

  <!-- OVERVIEW -->
  <section class="section" id="overview">
    <h2>Overview</h2>
    <hr class="section-rule" />

    <div class="stats-grid">
      <div class="stat">
        <span class="stat-value">{currentDay}</span>
        <span class="stat-label">Simulated Days</span>
      </div>
      <div class="stat">
        <span class="stat-value">{totalTicks}</span>
        <span class="stat-label">Total Ticks</span>
      </div>
      <div class="stat">
        <span class="stat-value">{totalScenes}</span>
        <span class="stat-label">Scenes</span>
      </div>
      <div class="stat">
        <span class="stat-value">{totalSolos}</span>
        <span class="stat-label">Solo Moments</span>
      </div>
      <div class="stat">
        <span class="stat-value">{overallRatio}%</span>
        <span class="stat-label">Scene Ratio</span>
      </div>
      <div class="stat">
        <span class="stat-value">{currentSeason}</span>
        <span class="stat-label">Current Season</span>
      </div>
    </div>

    <p class="note">
      Data shown from Day 6 onwards. Days 1-5 excluded — early API quota issues caused characters to be silently skipped, making those numbers unreliable. Day 9 reflects the first day of the new simulation timing (8 characters active every tick, hourly ticks with sleep window).
    </p>
  </section>

  <!-- SCENE RATIO -->
  <section class="section" id="scene-ratio">
    <h2>Scene Ratio</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      A scene happens when two or more characters are in the same location at the same tick. Solo moments are single characters posting alone. The ratio measures how much of the simulation is interaction versus monologue. Target is 50-60%.
    </p>

    <div class="ratio-chart">
      {dayData.map(d => {
        return (
          <div class="ratio-row">
            <span class="ratio-label">Day {d.day}</span>
            <div class="ratio-bar-track">
              <div class="ratio-bar-scene" style={`width: ${d.scene_pct}%`}>
                {d.scene_pct > 15 ? `${d.scenes} scenes` : ''}
              </div>
              <div class="ratio-bar-solo" style={`width: ${100 - d.scene_pct}%`}>
                {100 - d.scene_pct > 15 ? `${d.solos} solo` : ''}
              </div>
            </div>
            <span class="ratio-pct">{d.scene_pct}%</span>
          </div>
        );
      })}
    </div>
    <p class="target-line">Target: 50% &mdash; Day 9 reached 41% on first day of new timing</p>
  </section>

  <!-- CHARACTER PAIRS -->
  <section class="section" id="pairs">
    <h2>Character Pairs</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      Which characters share scenes most often. A social map of Ravensville — who gravitates toward whom, who avoids whom, who is everyone's neighbor.
    </p>

    <table class="pairs-table">
      <thead>
        <tr>
          <th>Pair</th>
          <th>Scenes</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {topPairs.map(pair => (
          <tr>
            <td>{pair.a} &amp; {pair.b}</td>
            <td><span class="pair-count">{pair.count}</span></td>
            <td>
              <span
                class="pair-bar"
                style={`width: ${Math.round(pair.count / topPairs[0].count * 80)}px`}
              ></span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">Dr. Julian Hale appears in 4 of the top 5 pairs — the most socially active character. Sister Lila and Sophie Laurent lead all pairs with 7 shared scenes.</p>
  </section>

  <!-- LOCATIONS -->
  <section class="section" id="locations">
    <h2>Location Activity</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      Where scenes happen. Town square dominates as the crossroads everyone passes through. The Twisted Olive and Brewsome are the evening and morning hubs. Vance Therapy and the Park are intentionally quiet — their scenes are rarer but carry more weight.
    </p>

    <div class="location-bars">
      {locationData.map(loc => (
        <div class="loc-row">
          <span class="loc-name">#{loc.name}</span>
          <div class="loc-track">
            <div
              class="loc-fill"
              style={`width: ${Math.round(loc.scenes / maxLocationScenes * 100)}%`}
            ></div>
          </div>
          <span class="loc-count">{loc.scenes}</span>
        </div>
      ))}
    </div>
    <p class="note">Roaming schedules updated May 20 to reflect natural human patterns — morning park walks, office hours at Vance Therapy, evening convergence at the Twisted Olive. Rerun after Day 12+ to see the shift.</p>
  </section>

  <!-- WEEKLY VITALS -->
  <section class="section" id="weekly-vitals">
    <h2>Weekly Vitals</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      Simulation health metrics by week. Scene ratio, volume, and standout pairs — a quick pulse on how each week ran.
    </p>

    <table class="vitals-table">
      <thead>
        <tr>
          <th>Week</th>
          <th>Days</th>
          <th>Scenes</th>
          <th>Solos</th>
          <th>Ratio</th>
          <th>Top Location</th>
          <th>Top Pair</th>
        </tr>
      </thead>
      <tbody>
        {weeks.map(w => (
          <tr>
            <td><span class="vitals-number">{w.week}</span></td>
            <td style="font-family: var(--mono); font-size: 0.75rem; color: var(--mist);">
              {w.season} {w.days[0]}–{w.days[w.days.length - 1]}
            </td>
            <td><span class="vitals-number">{w.vitals.total_scenes}</span></td>
            <td style="font-family: var(--mono); font-size: 0.85rem; color: var(--mist);">{w.vitals.total_solos}</td>
            <td><span class="vitals-number">{w.vitals.scene_ratio}%</span></td>
            <td style="font-family: var(--mono); font-size: 0.75rem; color: var(--pale);">#{w.vitals.top_location}</td>
            <td>
              <span class="vitals-pair">{w.vitals.top_pair[0]} &amp; {w.vitals.top_pair[1]}</span>
              <span class="vitals-pair-count">×{w.vitals.top_pair_count}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- CHARACTER PULSE -->
  <section class="section" id="character-pulse">
    <h2>Character Pulse</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      Per-character scene and solo counts for the most recent week. Who is in the mix, who is pulling back, who everyone gravitates toward.
    </p>

    <span class="pulse-week-label">
      Week {latestWeek.week} — {latestWeek.season}, Days {latestWeek.days[0]}–{latestWeek.days[latestWeek.days.length - 1]}
    </span>

    <table class="pulse-table">
      <thead>
        <tr>
          <th>Character</th>
          <th>Scenes</th>
          <th>Solo</th>
          <th>Top Partner</th>
        </tr>
      </thead>
      <tbody>
        {latestWeek.character_pulse.map(c => (
          <tr>
            <td><span class="pulse-char">{c.character}</span></td>
            <td><span class="pulse-count">{c.scenes}</span></td>
            <td><span class="pulse-solo">{c.solos}</span></td>
            <td style="font-size: 0.85rem; color: var(--mist);">{c.top_partner}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">Scene counts reflect shared-scene participation, not unique conversations. A character in a 4-person scene counts once per tick.</p>
  </section>

  <!-- EMERGENT PATTERNS -->
  <section class="section" id="emergent">
    <h2>Emergent Patterns</h2>
    <hr class="section-rule" />
    <p style="color: var(--pale); font-size: 0.95rem; margin-bottom: 1.5rem;">
      Behaviors and patterns that arose without instruction. What the simulation produced that nobody explicitly programmed.
    </p>

    {weeks.map(w => (
      <div style="margin-bottom: 3rem;">
        <span class="patterns-week-eyebrow">Week {w.week} — {w.season}, Days {w.days[0]}–{w.days[w.days.length - 1]}</span>
        <ul class="patterns-list">
          {w.emergent_patterns.map((p, i) => (
            <li class="pattern-item">
              <span class="pattern-bullet">0{i + 1}</span>
              <span class="pattern-text">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <div class="update-note">
    Observatory v1 — {currentSeason}, Day {currentDay} — Data from Days 6-{currentDay}<br/>
    The heatmap, entropy tracking, and topic analysis are coming as the simulation accumulates history.<br/>
    Analytics run daily. Next update after Day {currentDay + 1}.
  </div>
</Base>
