---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const echoes = await getCollection('echoes');
  return echoes.map(echo => ({
    params: { slug: echo.id },
    props: { echo },
  }));
}

const { echo } = Astro.props;
const { Content } = await render(echo);
---
<Base title={echo.data.title} description={echo.data.summary}>
  <style>
    .back {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--mist);
      display: inline-block;
      margin-bottom: 3rem;
    }
    .back:hover { color: var(--amber); }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 1rem;
      display: block;
    }
    h1 {
      font-family: var(--serif);
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      line-height: 1.2;
      color: var(--paper);
      margin-bottom: 2.5rem;
      letter-spacing: -0.01em;
    }
    .summary {
      font-size: 1.15rem;
      color: var(--cream);
      font-style: italic;
      border-left: 2px solid var(--amber);
      padding-left: 1.5rem;
      margin-bottom: 2.5rem;
      line-height: 1.75;
    }
    .body {
      font-size: 1.05rem;
      color: var(--pale);
      line-height: 1.9;
      margin-bottom: 3.5rem;
    }
    .body p { margin-bottom: 1.25rem; }
    .scenes-header {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--mist);
      margin-bottom: 1.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--ash);
    }
    .scene {
      border: 1px solid var(--ash);
      border-left: 3px solid var(--rust);
      padding: 1.25rem 1.5rem;
      margin-bottom: 1rem;
      background: rgba(26,24,20,0.6);
    }
    .scene-meta {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--mist);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }
    .scene-excerpt {
      font-size: 0.95rem;
      color: var(--pale);
      font-style: italic;
      line-height: 1.7;
    }
  </style>

  <a href="/echoes" class="back">&larr; All dispatches</a>
  <span class="eyebrow">{echo.data.season}, Day {echo.data.day} &mdash; {echo.data.pubDate}</span>
  <h1>{echo.data.title}</h1>
  {echo.data.summary && <p class="summary">{echo.data.summary}</p>}
  <div class="body"><Content /></div>
  {echo.data.scenes && echo.data.scenes.length > 0 && (
    <>
      <p class="scenes-header">From the record &mdash; selected exchanges</p>
      {echo.data.scenes.map(scene => (
        <div class="scene">
          <p class="scene-meta">{scene.character} &mdash; #{scene.location}</p>
          <p class="scene-excerpt">"{scene.excerpt}"</p>
        </div>
      ))}
    </>
  )}
</Base>
